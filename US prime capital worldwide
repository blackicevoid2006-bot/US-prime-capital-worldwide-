    <script>
        // Web Audio API Sound Generator for Button Clicks
        function playClickSound() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(600, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(200, audioCtx.currentTime + 0.04);
                gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.04);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.04);
            } catch(e) {}
        }

        // In-App Toast Notification System
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            let icon = '✅';
            if(type === 'error') icon = '❌';
            if(type === 'warning') icon = '⚠️';
            
            toast.innerHTML = `<span>${icon}</span> <div>${message}</div>`;
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(50px)';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        let isSignUpMode = false;
        let currentUser = null;
        let yieldInterval = null;
        const dailyRate = 0.02;
        const secondRate = Math.pow(1 + dailyRate, 1 / 86400) - 1;
        
        const ADMIN_EMAIL = "yourrealemail@gmail.com"; // Replace with your actual admin email

        window.onload = function() {
            setTimeout(() => {
                const splash = document.getElementById('splash-screen');
                if(splash) {
                    splash.style.opacity = '0';
                    splash.style.visibility = 'hidden';
                }
            }, 1200);

            const urlParams = new URLSearchParams(window.location.search);
            const refParam = urlParams.get('ref');
            if(refParam) {
                localStorage.setItem('meridian_pending_ref', refParam.trim().toLowerCase());
            }

            const savedUser = localStorage.getItem('meridian_active_user');
            if (savedUser) loginUser(savedUser);
        };

        function toggleAuthMode() {
            isSignUpMode = !isSignUpMode;
            document.getElementById('name-group').style.display = isSignUpMode ? 'block' : 'none';
            document.getElementById('gender-group').style.display = isSignUpMode ? 'block' : 'none';
            document.getElementById('pin-group').style.display = 'block';
            document.getElementById('auth-title').innerText = isSignUpMode ? 'Investor Registration' : 'Global Access';
            document.getElementById('auth-btn').innerText = isSignUpMode ? 'Initialize Account' : 'Sign In';
            document.getElementById('auth-switch-text').innerHTML = isSignUpMode ? 
                'Already have an account? <span onclick="playClickSound(); toggleAuthMode();">Sign in</span>' : 
                'Don\'t have an account? <span onclick="playClickSound(); toggleAuthMode();">Create account</span>';
        }

        function handleAuth() {
            const email = document.getElementById('auth-email').value.trim().toLowerCase();
            const password = document.getElementById('auth-password').value;
            const name = document.getElementById('auth-name').value.trim() || 'Investor';
            const gender = document.getElementById('auth-gender').value;
            const pin = document.getElementById('auth-pin').value.trim();

            if(!email || !password) {
                showAuthError('Please enter all required credentials.');
                showToast('Please enter all required credentials.', 'error');
                return;
            }

            if(isSignUpMode && (!pin || pin.length !== 4)) {
                showAuthError('Please enter a valid 4-digit security PIN for withdrawals.');
                showToast('Please enter a valid 4-digit security PIN.', 'error');
                return;
            }

            let users = JSON.parse(localStorage.getItem('meridian_users') || '{}');

            if(isSignUpMode) {
                if(users[email]) {
                    showAuthError('An account with this email address already exists.');
                    showToast('Account already exists with this email.', 'error');
                    return;
                }
                let referredBy = localStorage.getItem('meridian_pending_ref') || '';
                users[email] = { 
                    name: name, 
                    gender: gender, 
                    password: password, 
                    pin: pin,
                    balance: 0.00, 
                    startTime: Date.now(), 
                    pendingWithdrawal: 0, 
                    referredBy: referredBy,
                    hasDeposited: false 
                };
                localStorage.setItem('meridian_users', JSON.stringify(users));
                loginUser(email);
                showToast('Account successfully initialized!', 'success');
            } else {
                if(!users[email] && email === ADMIN_EMAIL) {
                    users[email] = { name: "System Admin", gender: "Prefer not to say", password: password, pin: "1234", balance: 0.00, startTime: Date.now(), pendingWithdrawal: 0, referredBy: "", hasDeposited: true };
                    localStorage.setItem('meridian_users', JSON.stringify(users));
                } else if(!users[email] || users[email].password !== password) {
                    showAuthError('Invalid email or password.');
                    showToast('Invalid email or password.', 'error');
                    return;
                }
                loginUser(email);
                showToast('Successfully signed in.', 'success');
            }
        }

        function loginUser(email) {
            currentUser = email;
            localStorage.setItem('meridian_active_user', email);
            
            let users = JSON.parse(localStorage.getItem('meridian_users') || '{}');
            let userData = users[email] || { name: 'Investor', gender: 'Not specified', balance: 0, pin: '1234' };

            document.getElementById('nav-user-name').innerText = userData.name || 'Investor';
            document.getElementById('nav-user-email').innerText = email;
            document.getElementById('form-user-email').value = email;
            document.getElementById('user-avatar').innerText = (userData.name || 'M').charAt(0).toUpperCase();
            
            document.getElementById('profile-email-view').innerText = email;
            document.getElementById('profile-pass-view').innerText = userData.password;
            document.getElementById('profile-pin-view').innerText = userData.pin || '1234';
            document.getElementById('profile-gender-view').innerText = userData.gender || 'Not specified';
            document.getElementById('affiliate-link').value = `${window.location.origin}${window.location.pathname}?ref=${encodeURIComponent(email)}`;

            document.getElementById('auth-screen').classList.add('hidden');
            document.getElementById('app-screen').classList.remove('hidden');

            if(email === ADMIN_EMAIL) {
                document.getElementById('admin-indicator').classList.remove('hidden');
                document.getElementById('admin-panel').classList.remove('hidden');
            }

            startYieldTicker();
        }

        function logout() {
            clearInterval(yieldInterval);
            localStorage.removeItem('meridian_active_user');
            currentUser = null;
            document.getElementById('app-screen').classList.add('hidden');
            document.getElementById('auth-screen').classList.remove('hidden');
            showToast('Signed out successfully.', 'warning');
        }

        function getUserData(email = currentUser) {
            let users = JSON.parse(localStorage.getItem('meridian_users') || '{}');
            return users[email] || { balance: 0, startTime: Date.now(), pendingWithdrawal: 0, referredBy: '', hasDeposited: false, pin: '1234' };
        }

        function saveUserData(data, email = currentUser) {
            let users = JSON.parse(localStorage.getItem('meridian_users') || '{}');
            users[email] = data;
            localStorage.setItem('meridian_users', JSON.stringify(users));
        }

        function startYieldTicker() {
            if(yieldInterval) clearInterval(yieldInterval);
            yieldInterval = setInterval(() => {
                let data = getUserData();
                if(data.balance > 0) {
                    let now = Date.now();
                    let secondsElapsed = (now - data.startTime) / 1000;
                    let currentBalance = data.balance * Math.pow(1 + secondRate, secondsElapsed);
                    document.getElementById('display-balance').innerText = `$${currentBalance.toFixed(2)}`;
                } else {
                    document.getElementById('display-balance').innerText = `$0.00`;
                }
            }, 1000);
        }

        function switchTab(tabName) {
            ['dashboard', 'deposit', 'withdraw', 'affiliate', 'settings'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.add('hidden');
                document.getElementById(`tab-btn-${t.substring(0,4)}`)?.classList.remove('active');
            });
            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            document.getElementById(`tab-btn-${tabName.substring(0,4)}`)?.classList.add('active');
        }

        function updateFilePreview(input) {
            if(input.files[0]) {
                document.getElementById('file-label-text').innerText = `Selected: ${input.files[0].name}`;
            }
        }

        function handleDepositSubmit(e) {
            let amt = parseFloat(document.getElementById('deposit-amount-input').value);
            if(!amt || amt < 50) {
                showToast('Minimum deposit amount is $50 USDT.', 'error');
                e.preventDefault();
                return false;
            }
            showToast('Deposit proof transmitted successfully! Balance and welcome bonus will update upon admin verification.', 'success');
            return true;
        }

        function requestWithdrawal() {
            let amt = parseFloat(document.getElementById('withdraw-amount').value);
            let addr = document.getElementById('withdraw-address').value.trim();
            let pinInput = document.getElementById('withdraw-pin').value.trim();
            let data = getUserData();

            let now = Date.now();
            let secondsElapsed = (now - data.startTime) / 1000;
            let currentBalance = data.balance > 0 ? data.balance * Math.pow(1 + secondRate, secondsElapsed) : 0;

            if(!amt || amt < 50 || !addr || !pinInput) {
                showToast('Please enter a valid amount (Minimum $50), destination address, and your 4-digit PIN.', 'error');
                return;
            }

            if(pinInput !== data.pin) {
                showToast('Incorrect security PIN. Access denied.', 'error');
                return;
            }

            if(amt > currentBalance) {
                showToast('Requested amount exceeds available compounding balance.', 'error');
                return;
            }

            data.balance = Math.max(0, currentBalance - amt);
            data.startTime = Date.now();
            data.pendingWithdrawal = amt;

            saveUserData(data);

            showToast('Withdrawal request submitted successfully! Pending payout execution.', 'success');
            document.getElementById('withdraw-amount').value = '';
            document.getElementById('withdraw-address').value = '';
            document.getElementById('withdraw-pin').value = '';
            switchTab('dashboard');
        }

        // ADMIN FUNCTIONS
        function adminCreditUser() {
            let targetEmail = document.getElementById('admin-target-email').value.trim().toLowerCase();
            let creditAmt = parseFloat(document.getElementById('admin-credit-amount').value);
            
            if(!targetEmail || !creditAmt || creditAmt < 50) {
                showToast('Enter valid target user email and minimum deposit amount of $50.', 'error');
                return;
            }

            let userData = getUserData(targetEmail);
            let now = Date.now();
            let secondsElapsed = (now - userData.startTime) / 1000;
            let currentBalance = userData.balance > 0 ? userData.balance * Math.pow(1 + secondRate, secondsElapsed) : 0;

            let firstTimeDeposit = !userData.hasDeposited;
            let finalCredit = creditAmt;
            let welcomeBonusMsg = "";

            if(firstTimeDeposit && userData.referredBy) {
                let welcomeBonus = creditAmt * 0.10;
                finalCredit += welcomeBonus;
                welcomeBonusMsg = ` (Includes 10% Welcome Bonus of $${welcomeBonus.toFixed(2)})`;
            }

            userData.balance = currentBalance + finalCredit;
            userData.startTime = Date.now();
            userData.hasDeposited = true;

            saveUserData(userData, targetEmail);

            let sponsorMsg = "";
            if(firstTimeDeposit && userData.referredBy) {
                let sponsorEmail = userData.referredBy;
                let sponsorData = getUserData(sponsorEmail);
                if(sponsorData) {
                    let sponsorNow = Date.now();
                    let sponsorElapsed = (sponsorNow - sponsorData.startTime) / 1000;
                    let sponsorBalance = sponsorData.balance > 0 ? sponsorData.balance * Math.pow(1 + secondRate, sponsorElapsed) : 0;
                    
                    let sponsorBonus = creditAmt * 0.20;
                    sponsorData.balance = sponsorBalance + sponsorBonus;
                    sponsorData.startTime = Date.now();
                    saveUserData(sponsorData, sponsorEmail);
                    sponsorMsg = ` | 20% Sponsor Bonus ($${sponsorBonus.toFixed(2)}) credited to ${sponsorEmail}`;
                }
            }

            showToast(`Approved $${creditAmt} for ${targetEmail}.${welcomeBonusMsg}${sponsorMsg}`, 'success');
            document.getElementById('admin-target-email').value = '';
            document.getElementById('admin-credit-amount').value = '';
        }

        function adminResolveWithdrawal(action) {
            let targetEmail = document.getElementById('admin-target-email').value.trim().toLowerCase();
            if(!targetEmail) {
                showToast('Enter target user email in the admin console above.', 'error');
                return;
            }

            let userData = getUserData(targetEmail);
            if(!userData.pendingWithdrawal || userData.pendingWithdrawal <= 0) {
                showToast('No pending withdrawal found for this email.', 'error');
                return;
            }

            if(action === 'approve') {
                userData.pendingWithdrawal = 0;
                showToast(`Withdrawal of $${userData.pendingWithdrawal} approved and cleared for ${targetEmail}.`, 'success');
            } else {
                userData.balance += userData.pendingWithdrawal;
                userData.pendingWithdrawal = 0;
                userData.startTime = Date.now();
                showToast(`Withdrawal rejected. Refunded $${userData.pendingWithdrawal} back to portfolio.`, 'warning');
            }

            saveUserData(userData, targetEmail);
        }

        function saveSettings() {
            let newName = document.getElementById('settings-name').value.trim();
            if(newName) {
                let data = getUserData();
                data.name = newName;
                saveUserData(data);
                document.getElementById('nav-user-name').innerText = newName;
                document.getElementById('user-avatar').innerText = newName.charAt(0).toUpperCase();
                showToast('Profile updated successfully.', 'success');
            } else {
                showToast('Please enter a valid display name.', 'error');
            }
        }

        function copyAffiliateLink() {
            const linkInput = document.getElementById('affiliate-link');
            linkInput.select();
            linkInput.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(linkInput.value);
            showToast('Affiliate referral link copied to clipboard!', 'success');
        }

        function showAuthError(msg) {
            const err = document.getElementById('auth-error');
            err.innerText = msg;
            err.classList.remove('hidden');
        }
    </script>
</body>
</html>
