<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>US Prime Capital Worldwide | Institutional Asset Management</title>
    <style>
        :root {
            --bg-color: #0b0f17;
            --card-bg: #131c31;
            --card-border: #1e293b;
            --accent: #38bdf8;
            --accent-glow: rgba(56, 189, 248, 0.15);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --success: #22c55e;
            --warning: #f59e0b;
            --danger: #ef4444;
            --transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        
        body { 
            background-color: var(--bg-color); 
            color: var(--text-main); 
            min-height: 100vh; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            padding: 16px; 
            background-image: radial-gradient(circle at 50% 0%, #152238 0%, var(--bg-color) 70%);
        }

        /* Toast Notification Container */
        #toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 10000;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 360px;
            width: 100%;
            pointer-events: none;
        }
        .toast {
            background: #182238;
            border: 1px solid var(--card-border);
            color: var(--text-main);
            padding: 14px 18px;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            font-size: 0.84rem;
            display: flex;
            align-items: center;
            gap: 12px;
            pointer-events: auto;
            animation: slideInToast 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            border-left: 4px solid var(--accent);
        }
        .toast.success { border-left-color: var(--success); }
        .toast.error { border-left-color: var(--danger); }
        .toast.warning { border-left-color: var(--warning); }

        @keyframes slideInToast {
            from { opacity: 0; transform: translateX(50px); }
            to { opacity: 1; transform: translateX(0); }
        }

        #splash-screen {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: var(--bg-color);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: opacity 0.5s ease, visibility 0.5s ease;
        }
        .splash-logo {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            color: var(--accent);
            font-weight: 700;
            margin-bottom: 8px;
            animation: pulseGlow 1.5s infinite alternate;
        }
        .splash-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--text-main);
            opacity: 0;
            animation: fadeInUp 0.7s ease 0.2s forwards;
        }
        @keyframes pulseGlow {
            from { text-shadow: 0 0 10px rgba(56, 189, 248, 0.2); }
            to { text-shadow: 0 0 25px rgba(56, 189, 248, 0.5); }
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .container { 
            width: 100%; 
            max-width: 440px; 
            background: var(--card-bg); 
            border-radius: 24px; 
            border: 1px solid var(--card-border); 
            padding: 28px; 
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
            animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            position: relative;
            overflow: hidden;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .hidden { display: none !important; }

        .brand-header { text-align: center; margin-bottom: 20px; }
        .brand-logo { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 3px; color: var(--accent); font-weight: 700; margin-bottom: 6px; }
        h1 { font-size: 1.5rem; font-weight: 700; color: var(--text-main); letter-spacing: -0.5px; }
        h2 { font-size: 1.1rem; font-weight: 600; margin-bottom: 14px; color: var(--text-main); text-align: left; }
        p { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 18px; line-height: 1.5; }

        .lang-picker { text-align: right; margin-bottom: 12px; }
        .lang-select { background: #0b0f17; border: 1px solid var(--card-border); color: var(--text-muted); padding: 4px 8px; border-radius: 8px; font-size: 0.72rem; outline: none; cursor: pointer; }

        .input-group { margin-bottom: 16px; text-align: left; }
        .input-group label { display: block; font-size: 0.72rem; font-weight: 600; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.8px; }
        
        input, select { 
            width: 100%; 
            padding: 13px 15px; 
            background: #0b0f17; 
            border: 1px solid var(--card-border); 
            border-radius: 12px; 
            color: var(--text-main); 
            font-size: 0.92rem; 
            transition: var(--transition); 
        }
        input:focus, select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }

        button { 
            width: 100%; 
            padding: 13px; 
            background: var(--accent); 
            border: none; 
            border-radius: 12px; 
            color: #0b0f17; 
            font-weight: 700; 
            font-size: 0.92rem; 
            cursor: pointer; 
            transition: var(--transition); 
            box-shadow: 0 4px 14px rgba(56, 189, 248, 0.2);
        }
        button:hover { opacity: 0.92; transform: translateY(-1px); }
        button:active { transform: translateY(1px); }

        .nav-tabs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; background: #0b0f17; padding: 4px; border-radius: 14px; border: 1px solid var(--card-border); margin-bottom: 20px; }
        .nav-tabs button { background: transparent; color: var(--text-muted); border: none; padding: 8px 1px; font-size: 0.6rem; border-radius: 8px; font-weight: 600; box-shadow: none; text-transform: uppercase; letter-spacing: 0.2px; }
        .nav-tabs button.active { background: var(--accent); color: #0b0f17; box-shadow: 0 2px 6px rgba(56, 189, 248, 0.2); }

        .balance-card { 
            background: #0b0f17; 
            border: 1px solid var(--card-border); 
            border-radius: 18px; 
            padding: 20px; 
            text-align: center; 
            margin-bottom: 16px; 
            position: relative; 
            overflow: hidden; 
        }
        .balance-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--accent), var(--success)); }
        .balance-amount { font-size: 2.2rem; font-weight: 800; color: var(--success); margin-top: 6px; font-variant-numeric: tabular-nums; letter-spacing: -1px; }
        
        .status-badge { background: #0b0f17; border: 1px solid var(--card-border); padding: 12px 14px; border-radius: 12px; font-size: 0.82rem; color: var(--warning); display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
        
        .wallet-box { background: #0b0f17; border: 1px solid var(--card-border); border-radius: 12px; padding: 14px; text-align: center; margin-bottom: 16px; }
        .wallet-address { font-size: 0.78rem; color: var(--accent); word-break: break-all; font-family: monospace; margin-top: 6px; background: rgba(56, 189, 248, 0.04); padding: 8px; border-radius: 8px; border: 1px dashed var(--accent); }

        .file-upload-container { margin-bottom: 16px; text-align: left; }
        .file-upload-label { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px; background: #0b0f17; border: 2px dashed var(--card-border); border-radius: 12px; cursor: pointer; color: var(--text-muted); font-size: 0.82rem; transition: var(--transition); }
        .file-upload-label:hover { border-color: var(--accent); color: var(--text-main); }

        .lore-banner {
            background: rgba(56, 189, 248, 0.03);
            border: 1px solid rgba(56, 189, 248, 0.1);
            border-radius: 12px;
            padding: 12px;
            font-size: 0.78rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 16px;
            text-align: left;
        }

        .auth-switch { text-align: center; margin-top: 16px; font-size: 0.82rem; color: var(--text-muted); }
        .auth-switch span { color: var(--accent); cursor: pointer; font-weight: 600; }

        .error-msg { background: rgba(239, 68, 68, 0.1); border: 1px solid var(--danger); color: var(--danger); padding: 10px; border-radius: 10px; font-size: 0.8rem; margin-bottom: 14px; text-align: center; }
        
        .header-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--card-border); }
        .user-profile-header { display: flex; align-items: center; gap: 10px; }
        .avatar-circle { width: 34px; height: 34px; border-radius: 50%; background: var(--accent); color: #0b0f17; font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; }
        .user-name-display { font-size: 0.82rem; font-weight: 600; color: var(--text-main); }
        .user-email-sub { font-size: 0.7rem; color: var(--text-muted); max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        
        .logout-btn { background: transparent; border: 1px solid var(--card-border); color: var(--danger); padding: 5px 10px; border-radius: 8px; font-size: 0.7rem; width: auto; font-weight: 600; cursor: pointer; }
        
        .admin-badge { background: rgba(245, 158, 11, 0.15); border: 1px solid var(--warning); color: var(--warning); padding: 4px 8px; border-radius: 6px; font-size: 0.65rem; font-weight: bold; text-transform: uppercase; margin-bottom: 10px; display: inline-block; }
        
        .admin-console-box { background: rgba(245, 158, 11, 0.04); border: 1px solid var(--warning); border-radius: 14px; padding: 16px; margin-bottom: 16px; text-align: left; }
        .admin-console-title { font-size: 0.8rem; font-weight: 700; color: var(--warning); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; display: flex; align-items: center; gap: 6px; }
        .admin-section-divider { border: 0; height: 1px; background: rgba(245, 158, 11, 0.2); margin: 14px 0; }

        .credential-box { background: #0b0f17; border: 1px solid var(--card-border); border-radius: 12px; padding: 14px; margin-bottom: 16px; text-align: left; font-size: 0.8rem; }
        .credential-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid var(--card-border); }
        .credential-row:last-child { border-bottom: none; }
    </style>
</head>
